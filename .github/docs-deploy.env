# Repository-level docs deployment settings consumed by .github/workflows/deploy-docs.yml.
BIJUX_DOCS_INSTALL_COMMAND="make gh-docs-install"
BIJUX_DOCS_BUILD_COMMAND="make docs-check"
BIJUX_DOCS_SITE_DIR="artifacts/docs/site"
BIJUX_DOCS_VERIFY_COMMAND="bash .bijux/shared/bijux-docs/tooling/scripts/verify_bijux_docs_site.sh"
BIJUX_DOCS_SETUP_PYTHON='true'
BIJUX_DOCS_PYTHON_VERSION='3.11'
BIJUX_DOCS_SETUP_NODE='true'
BIJUX_DOCS_NODE_VERSION='24.21.0'
